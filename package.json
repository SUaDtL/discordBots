{
  "name": "discord-bots",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-bot Discord monorepo (npm workspaces).",
  "license": "MIT",
  "author": "Brennon Huff",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "bots/*",
    "tools/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.5.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}
