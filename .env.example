# Copy this file to `.env` and fill in the values. `.env` is gitignored and is
# loaded by docker compose (env_file) — never commit real tokens.
#
#   cp .env.example .env
#
# Each bot reads ONLY its own token (DISCORD_TOKEN_<SLUG_UPPER>), per the
# least-privilege, one-token-per-process model (ADR-0003).

# Shared application id used when registering slash commands (deploy-commands).
DISCORD_APPLICATION_ID=

# Per-bot bot tokens.
DISCORD_TOKEN_DUNGEON_HERALD=
DISCORD_TOKEN_ARBITER_SELF_ASSIGN=
